# Postgres (Railway lo inyecta automaticamente al agregar el addon)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Cuenta Gmail
GMAIL_ADDRESS=rafael.fuenzalida@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Labels de Gmail. IMPORTANTE: usar el nombre EXACTO del label (con mayusculas,
# '/' de anidado y espacios), porque para agregar/quitar labels Gmail exige el
# nombre exacto (la busqueda es tolerante, pero el mover no).
GMAIL_LABEL=Gridworks/Contabilidad
# Label donde se mueven las facturas al aceptarlas manualmente (declaradas al SII)
GMAIL_DECLARED_LABEL=Gridworks/Contabilidad/SII/Compras Declaradas

# Clave para firmar las cookies de sesion y los enlaces de recuperacion.
# Obligatoria, sin default: la app no arranca sin ella. Minimo 32 caracteres,
# no puede ser un valor de ejemplo. Generarla con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambia-esto-por-una-generada

# En produccion con HTTPS (Railway/Cloudflare) poner true; en local dejar vacio
COOKIE_SECURE=

# URL publica de la app, para armar el enlace del correo de recuperacion de clave
BASE_URL=http://localhost:8000

# Solo para crear la primera cuenta (unicamente si la tabla usuarios esta
# vacia). Se pueden borrar del entorno una vez que esa cuenta existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Zona horaria opcional
TZ=America/Santiago
